{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "A label displaying the result value and unit of a medical test. The argument is the result value, and the second argument is the unit of measurement.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ • %lld Pg • %@" : {
      "comment" : "A label displaying the date, page count, and file size of a document. The first argument is the formatted date. The second argument is the number of pages. The third argument is the file size.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ • %2$lld Pg • %3$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A badge displaying the number of notifications. The argument is the number of notifications.",
      "isCommentAutoGenerated" : true
    },
    "• %@" : {
      "comment" : "A bullet point list item. The text is generated from the `recommendedActions` array in the `MedicalReportModel`.",
      "isCommentAutoGenerated" : true
    },
